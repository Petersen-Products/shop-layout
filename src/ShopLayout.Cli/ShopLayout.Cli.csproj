<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShopLayout.Cli</RootNamespace>
    <AssemblyName>ShopLayoutExport</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShopLayout.Core\ShopLayout.Core.csproj" />
    <ProjectReference Include="..\ShopLayout.SolidWorks\ShopLayout.SolidWorks.csproj" />
    <ProjectReference Include="..\ShopLayout.Drawio\ShopLayout.Drawio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\export.config.json" Link="export.config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\import_cleanup.json" Link="import_cleanup.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

